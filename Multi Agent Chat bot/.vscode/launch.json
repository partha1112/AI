{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: PII Sanitizer Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "backend/guardrailsAI/test_PIISanitizer.py",
        "-v",
        "-s"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Coordinator Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "backend/agents/test_coordinator.py",
        "-v",
        "-s"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Uvicorn (no reload + debug)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/api.py",
      "justMyCode": false,
      "subProcess": true,
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Attach (debugpy)",
      "type": "python",
      "request": "attach",
      "port": 5678,
      "host": "localhost",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "FastAPI: backend.api",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/backend/api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}