{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Uvicorn (reload + debug)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.api:app", "--host", "0.0.0.0", "--port", "8000"],
      "justMyCode": false,
      "subProcess": true,
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Attach (debugpy)",
      "type": "python",
      "request": "attach",
      "port": 5678,
      "host": "localhost",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "FastAPI: backend.api",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "backend.api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
